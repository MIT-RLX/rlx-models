/target
**/target
**/*.rs.bak

.DS_Store
**/.DS_Store
**/__pycache__/
.env
.env.local

# Local weight caches (GGUF / safetensors trees used by env-gated tests)
/weights
./weights
# Centralized TTS weights (downloaded + generated) — staged for a standalone
# Hugging Face weights repo; never committed to the main repo.
/weights/tts/
weights/tts/
# Per-crate model-weight dirs (blobs live outside git). Matches crate-level
# `weights/` only — source `src/weights/` (rlx-ocr) and `weights.rs` stay tracked.
crates/*/weights/
crates/rlx-neutts/models/
**/neucodec_decoder.safetensors

# Qwen3-TTS parity fixtures (bake locally; see tests/qwen3_tts_*_parity)
crates/rlx-qwen3-tts/tests/fixtures/st_encoder_parity.safetensors
crates/rlx-qwen3-tts/tests/fixtures/speaker_parity.safetensors

# SAM / PyTorch parity helpers (see tests/sam*_parity_helpers/)
.venv-*/

# Local Cargo registry overrides (see .cargo/config.toml.example)
.cargo/config.toml

# HF / model download caches
.cache/

# Editor / agent scratch
.claude/

# Ad-hoc audio at repo root (crate examples/audio/ is tracked)
/*.wav

# Ad-hoc Whisper / subtitle dumps at repo root (from local TTS runs)
/*.srt
/*.tsv
/*.vtt
# Named JSON/TXT dumps from Whisper / ORT harness runs (not package manifests)
/cpu_*.json
/cpu_*.txt
/ort_*.json
/ort_*.txt
/f5_*.json
/f5_*.txt
/mimi_*.json
/mimi_*.txt
/sesame_*.json
/sesame_*.txt
/soprano*.json
/soprano*.txt

# Local scratch (wavs, dumps, notebooks)
/scratchpad/
/tmp/

# Local agent docs — keep out of the repo
AGENTS.md
PLAN.md

papers/*

# rlx-snac large parity fixture (regenerate via crates/rlx-snac/scripts/gen_fixture.py)
crates/rlx-snac/tests/fixtures/snac24_decoder.safetensors
crates/rlx-encodec/tests/fixtures/encodec24.safetensors
crates/rlx-speechtokenizer/tests/fixtures/*.safetensors
crates/rlx-wavtokenizer/tests/fixtures/*.safetensors
crates/rlx-xcodec/tests/fixtures/*.safetensors

# eagle3 verifier bench weights (multi-GB GGUF; download/generate locally)
.eagle3-bench/

# Top-level parity-dump fixtures (regenerate via dump scripts/examples)
/fixtures/

# Local Cargo override backups (alongside .cargo/config.toml; see *.example)
.cargo/config.toml.bak
.cargo/config.toml.disabled

# Regenerable parity / reference fixtures (gen via crates/*/scripts/gen_fixture.py).
# Per-crate tests/fixtures/.gitignore files are tracked; these are repo-wide nets.
crates/*/tests/fixtures/*.bin
crates/*/tests/fixtures/*.json
crates/*/tests/fixtures/*.txt
crates/rlx-whisper/fixtures/
# Required build asset (baked via include_str!), not a regenerable fixture:
!crates/rlx-orpheus/tests/fixtures/orpheus_hi_codes.txt
