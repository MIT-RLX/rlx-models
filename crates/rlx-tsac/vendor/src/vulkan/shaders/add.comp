#version 460
layout(local_size_x = 256) in;
layout(binding = 0) readonly buffer A { float d[]; } a;
layout(binding = 1) readonly buffer B { float d[]; } b;
layout(binding = 2) buffer       O { float d[]; } o;
layout(push_constant) uniform P { int n; } p;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (int(i) >= p.n) return;
    o.d[i] = a.d[i] + b.d[i];
}
