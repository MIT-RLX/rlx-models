#version 460
layout(local_size_x = 256) in;
layout(binding = 0) readonly buffer In  { float d[]; } inBuf;
layout(binding = 1) readonly buffer Alpha { float d[]; } alphaBuf;
layout(binding = 2) buffer        Out { float d[]; } outBuf;
layout(push_constant) uniform P { int n; int C; } p;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (int(i) >= p.n) return;
    float x = inBuf.d[i];
    float a = alphaBuf.d[i % p.C];
    if (a < 1e-6) a = 1e-6;
    float sa = sin(a * x);
    outBuf.d[i] = x + (sa * sa) / a;
}
