# Local RLX development — patch crates.io 0.2.10 with a sibling checkout.
#
# Layout (recommended):
#   rlx-workspace/
#     rlx/           ← upstream RLX repo (v0.2.10+)
#     rlx-models/    ← this repo
#
# Enable local RLX:
#   cp .cargo/config.toml.example .cargo/config.toml
#
# Disable (crates.io only — same as CI / `cargo publish`):
#   rm .cargo/config.toml
#
# Rules:
# - Root Cargo.toml `[workspace.dependencies]` pins `rlx*` at =0.2.10.
# - `rlx-distributed` requires rlx-driver 0.2.10 (`ProcessGroup`, `TcpTransport`, …).
# - Every crate uses `{ workspace = true }` — no path deps to ../rlx in committed files.
# - Patches apply only when `.cargo/config.toml` exists (gitignored).
# - Patch ALL entries below together; a partial patch can break native `links` (e.g. mlx-sys).
#
[patch.crates-io]
rlx = { path = "../rlx/crates/rlx" }
rlx-ir = { path = "../rlx/crates/rlx-ir" }
rlx-flow = { path = "../rlx/crates/rlx-flow" }
rlx-runtime = { path = "../rlx/crates/rlx-runtime" }
rlx-compile = { path = "../rlx/crates/rlx-compile" }
rlx-opt = { path = "../rlx/crates/rlx-opt" }
rlx-autodiff = { path = "../rlx/crates/rlx-autodiff" }
rlx-fusion = { path = "../rlx/crates/rlx-fusion" }
rlx-driver = { path = "../rlx/crates/rlx-driver" }
rlx-cpu = { path = "../rlx/crates/rlx-cpu" }
rlx-gguf = { path = "../rlx/crates/rlx-gguf" }
rlx-nemo = { path = "../rlx/crates/rlx-nemo" }
rlx-text = { path = "../rlx/crates/rlx-text" }
rlx-onnx-import = { path = "../rlx/crates/rlx-onnx-import" }
rlx-metal = { path = "../rlx/crates/rlx-metal" }
rlx-mlx = { path = "../rlx/crates/rlx-mlx" }
rlx-mlx-sys = { path = "../rlx/crates/rlx-mlx-sys" }
rlx-cuda = { path = "../rlx/crates/rlx-cuda" }
rlx-wgpu = { path = "../rlx/crates/rlx-wgpu" }
rlx-rocm = { path = "../rlx/crates/rlx-rocm" }
