# Local RLX development — patch crates.io 0.2.14 with a sibling checkout.
#
# Layout (recommended):
#   rlx-workspace/
#     rlx/           ← upstream RLX repo (v0.2.14+)
#     rlx-models/    ← this repo
#
# Enable local RLX:
#   cp .cargo/config.toml.example .cargo/config.toml
#
# Disable (crates.io only — same as CI / `cargo publish`):
#   rm .cargo/config.toml
#
# Rules:
# - Root Cargo.toml `[workspace.dependencies]` pins `rlx*` at ^0.2.14.
# - `rlx-distributed` requires rlx-driver 0.2.14+ (`ProcessGroup`, `TcpTransport`, …).
# - Every crate uses `{ workspace = true }` — no path deps to ../rlx in committed files.
# - Patches apply only when `.cargo/config.toml` exists (gitignored).
# - Patch ALL entries below together; a partial patch can mix path/registry builds and break native `links` (e.g. mlx-sys).
#
[patch.crates-io]
rlx = { path = "../rlx/crates/rlx" }
rlx-ir = { path = "../rlx/crates/core/rlx-ir" }
rlx-flow = { path = "../rlx/crates/core/rlx-flow" }
rlx-runtime = { path = "../rlx/crates/core/rlx-runtime" }
rlx-compile = { path = "../rlx/crates/core/rlx-compile" }
rlx-opt = { path = "../rlx/crates/core/rlx-opt" }
rlx-optim = { path = "../rlx/crates/core/rlx-optim" }
rlx-autodiff = { path = "../rlx/crates/core/rlx-autodiff" }
rlx-fusion = { path = "../rlx/crates/core/rlx-fusion" }
rlx-driver = { path = "../rlx/crates/core/rlx-driver" }
rlx-cpu = { path = "../rlx/crates/backends/rlx-cpu" }
rlx-gguf = { path = "../rlx/crates/io/rlx-gguf" }
rlx-pkg = { path = "../rlx/crates/io/rlx-pkg" }
rlx-nemo = { path = "../rlx/crates/io/rlx-nemo" }
rlx-text = { path = "../rlx/crates/io/rlx-text" }
rlx-onnx-import = { path = "../rlx/crates/io/rlx-onnx-import" }
rlx-metal = { path = "../rlx/crates/backends/rlx-metal" }
rlx-mlx = { path = "../rlx/crates/backends/rlx-mlx" }
rlx-mlx-sys = { path = "../rlx/crates/backends/rlx-mlx-sys" }
rlx-mlx-io = { path = "../rlx/crates/io/rlx-mlx-io" }
rlx-cuda = { path = "../rlx/crates/backends/rlx-cuda" }
rlx-wgpu = { path = "../rlx/crates/backends/rlx-wgpu" }
rlx-vulkan = { path = "../rlx/crates/backends/rlx-vulkan" }
rlx-gpu-host = { path = "../rlx/crates/backends/rlx-gpu-host" }
rlx-rocm = { path = "../rlx/crates/backends/rlx-rocm" }
